# Site estático Poursuite (Astro) na hospedagem Apache/cPanel
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validação de certificado (AutoSSL) e caminhos do servidor
  RewriteRule ^\.well-known/ - [L]

  # www -> sem www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # HTTPS (considera o Cloudflare na frente)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # URLs do site antigo (WordPress)
  RewriteRule ^home/?$ / [L,R=301]
  RewriteRule ^about/?$ /quem-somos/ [L,R=301]
  RewriteRule ^service/?$ / [L,R=301]
  RewriteRule ^contact/?$ /contato/ [L,R=301]
  RewriteRule ^blog/?$ /conteudos/ [L,R=301]
  RewriteRule ^sample-page/?$ / [L,R=301]
  RewriteRule ^(comments/)?feed/?$ / [L,R=301]
  RewriteRule ^(wp-sitemap\.xml|sitemap_index\.xml)$ /sitemap.xml [L,R=301]
  RewriteRule ^category/ /conteudos/ [L,R=301]
  RewriteRule ^author/ / [L,R=301]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-content|wp-includes) / [L,R=301]

  # Barra final nas páginas (ex.: /contato -> /contato/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# Arquivos internos do projeto
<FilesMatch "^(_headers|_redirects|\.cpanel\.yml)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml text/plain
</IfModule>

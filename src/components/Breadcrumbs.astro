---
interface Props {
  label: string;
  items: { name: string; href?: string }[];
}
const { label, items } = Astro.props;
---

<nav class="crumbs" aria-label={label}>
  <ol>
    {
      items.map((it, i) => (
        <li>
          {it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    font-size: 0.88rem;
    color: var(--slate);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.35rem;
    color: #a9b5b3;
  }
  .crumbs a {
    color: var(--slate);
  }
  .crumbs a:hover {
    color: var(--teal-deep);
  }
</style>

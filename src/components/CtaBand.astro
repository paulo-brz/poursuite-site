---
interface Props {
  title: string;
  text: string;
  button: string;
  href: string;
}
const { title, text, button, href } = Astro.props;
---

<section class="section section--deep cta">
  <div class="wrap cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn" href={href}>{button}</a>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  h2 {
    color: var(--white);
    max-width: 20em;
  }
  p {
    margin-top: 0.85rem;
    color: #d6ebe8;
    font-size: var(--step-1);
    max-width: 34em;
  }
</style>

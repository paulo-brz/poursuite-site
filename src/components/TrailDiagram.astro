---
// Diagrama da "trilha patrimonial": do devedor aparentemente sem bens até onde o patrimônio costuma estar.
import type { Content } from '../content/types';
interface Props {
  trail: Content['home']['trail'];
}
const { trail } = Astro.props;
// Coordenadas no viewBox 560 x 480
const nodeY = [28, 138, 248, 358];
const NODE_H = 86;
const debtor = { x: 16, y: 226, w: 214, h: 90 };
const exec = { x: 16, y: 40, w: 214, h: 90 };
const nodeX = 318;
const startX = debtor.x + debtor.w;
const startY = debtor.y + debtor.h / 2;
const curves = nodeY.map((y) => {
  const ey = y + NODE_H / 2;
  const mx = startX + (nodeX - startX) * 0.55;
  return `M${startX},${startY} C${mx},${startY} ${mx},${ey} ${nodeX},${ey}`;
});
---

<figure class="trail" aria-labelledby="trail-caption">
  <div class="trail__canvas">
    <svg class="trail__lines" viewBox="0 0 560 480" aria-hidden="true" focusable="false">
      <defs>
        <filter id="trail-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <path class="trail__dead" d={`M${exec.x + exec.w / 2},${exec.y + exec.h} L${debtor.x + debtor.w / 2},${debtor.y}`} />
      <g filter="url(#trail-glow)">
        {curves.map((d, i) => <path class="trail__path" style={`--i:${i}`} d={d} />)}
      </g>
      <g class="trail__pulses">
        {
          curves.map((d, i) => (
            <circle r="2.6" class="trail__pulse">
              <animateMotion dur={`${2.6 + i * 0.35}s`} begin={`${1.8 + i * 0.4}s`} repeatCount="indefinite" path={d} />
            </circle>
          ))
        }
      </g>
      {nodeY.map((y, i) => <circle class="trail__dot" style={`--i:${i}`} cx={nodeX} cy={y + NODE_H / 2} r="4.5" />)}
      <circle class="trail__origin" cx={startX} cy={startY} r="5" />
    </svg>

    <div class="node node--exec" style={`--x:${exec.x};--y:${exec.y};--w:${exec.w};--h:${exec.h}`}>
      <span class="node__label">{trail.execution}</span>
      <span class="node__detail">{trail.executionDetail}</span>
    </div>
    <div class="node node--debtor" style={`--x:${debtor.x};--y:${debtor.y};--w:${debtor.w};--h:${debtor.h}`}>
      <span class="node__label">{trail.debtor}</span>
      <span class="node__detail">{trail.debtorDetail}</span>
    </div>
    <ul class="trail__assets">
      {
        trail.nodes.map((n, i) => (
          <li class="node node--asset" style={`--x:${nodeX};--y:${nodeY[i]};--w:${560 - nodeX};--h:${NODE_H};--i:${i}`}>
            <span class="node__label">{n.label}</span>
            <span class="node__detail">{n.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption id="trail-caption">
    <strong>{trail.title}.</strong> {trail.caption}
  </figcaption>
</figure>

<style>
  .trail {
    margin: 0;
  }
  .trail__canvas {
    position: relative;
    aspect-ratio: 560 / 480;
    container-type: inline-size;
  }
  .trail__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .trail__dead {
    fill: none;
    stroke: #7f918f;
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    opacity: 0.7;
  }
  .trail__path {
    fill: none;
    stroke: #5fc2b8;
    stroke-width: 2;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: draw 0.9s cubic-bezier(0.6, 0, 0.2, 1) forwards;
    animation-delay: calc(0.5s + var(--i) * 0.18s);
  }
  .trail__pulse {
    fill: #d8fffa;
    opacity: 0;
    animation: appear 0.4s 1.8s forwards;
  }
  .trail__dot {
    fill: #5fc2b8;
    opacity: 0;
    animation: appear 0.3s forwards;
    animation-delay: calc(1.2s + var(--i) * 0.18s);
  }
  .trail__origin {
    fill: var(--ink);
    stroke: #5fc2b8;
    stroke-width: 2;
  }
  .trail__assets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .node {
    position: absolute;
    left: calc(var(--x) / 560 * 100%);
    top: calc(var(--y) / 480 * 100%);
    width: calc(var(--w) / 560 * 100%);
    height: calc(var(--h) / 480 * 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15em;
    padding: 0 3.2cqw;
    font-size: 2.85cqw;
    line-height: 1.25;
    background: rgba(20, 34, 36, 0.72);
    border: 1px solid rgba(143, 211, 203, 0.22);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .node__label {
    font-weight: 600;
    color: #f2f7f6;
  }
  .node__detail {
    color: #9fb0ae;
    font-size: 0.9em;
  }
  .node--exec {
    background: rgba(255, 255, 255, 0.02);
    border-style: dashed;
    border-color: rgba(191, 205, 203, 0.35);
  }
  .node--exec .node__label {
    color: #aebdbb;
  }
  .node--debtor {
    border-color: rgba(242, 247, 246, 0.85);
    box-shadow: 4px 4px 0 var(--teal);
  }
  .node--asset {
    border-left: 3px solid #5fc2b8;
    opacity: 0;
    transform: translateX(-6px);
    animation: slide 0.45s ease-out forwards;
    animation-delay: calc(1.15s + var(--i) * 0.18s);
  }
  .node--asset .node__detail {
    color: #8fd3cb;
  }
  figcaption {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: #9fb0ae;
    max-width: 34rem;
  }
  figcaption strong {
    color: #e9efee;
    font-weight: 600;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @keyframes slide {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trail__pulses {
      display: none;
    }
  }

  /* Telas estreitas: o diagrama vira uma lista vertical */
  @media (max-width: 640px) {
    .trail__canvas {
      aspect-ratio: auto;
      container-type: normal;
    }
    .trail__lines {
      display: none;
    }
    .node {
      position: static;
      left: auto;
      top: auto;
      width: auto;
      height: auto;
      padding: 0.8rem 1rem;
      font-size: 0.95rem;
    }
    .node--exec {
      margin-bottom: 1.6rem;
      position: relative;
    }
    .node--exec::after {
      content: '';
      position: absolute;
      left: 1.5rem;
      top: 100%;
      height: 1.6rem;
      border-left: 1.5px dashed rgba(191, 205, 203, 0.45);
    }
    .node--debtor {
      margin-bottom: 0.5rem;
    }
    .trail__assets {
      margin-left: 1.5rem;
      padding-left: 1.25rem;
      border-left: 2px solid #5fc2b8;
      padding-top: 0.75rem;
      display: grid;
      gap: 0.6rem;
    }
  }
</style>
